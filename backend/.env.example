# ── Server
PORT=5000
NODE_ENV=production

# ── MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ── JWT
JWT_SECRET=<64-char-random-hex>
JWT_EXPIRES_IN=7d

# ── Anthropic (platform key — optional if users bring their own)
ANTHROPIC_API_KEY=sk-ant-...

# ── Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=<cloudflare-account-id>
R2_ACCESS_KEY_ID=<r2-access-key>
R2_SECRET_ACCESS_KEY=<r2-secret-key>
R2_BUCKET_NAME=codeatlas-repos
R2_PUBLIC_URL=https://<bucket>.<account>.r2.cloudflarestorage.com
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com

# ── Upstash Redis (BullMQ)
REDIS_URL=rediss://default:<token>@<host>.upstash.io:6379

# ── GitHub OAuth
GITHUB_CLIENT_ID=<github-client-id>
GITHUB_CLIENT_SECRET=<github-client-secret>
GITHUB_CALLBACK_URL=https://<your-render-app>.onrender.com/api/auth/github/callback

# ── Google OAuth
GOOGLE_CLIENT_ID=<google-client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-<google-client-secret>
GOOGLE_CALLBACK_URL=https://<your-render-app>.onrender.com/api/auth/google/callback

# ── URLs
FRONTEND_URL=https://<your-vercel-app>.vercel.app
BACKEND_URL=https://<your-render-app>.onrender.com
